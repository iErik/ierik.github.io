{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@root/*": [ "./*" ],
      "@/*": [ "./src/*" ],
      "@components/*": [
        "./src/components/*",
        "./src/components/*/index.vue"
      ],
      "@composables/*": [ "./src/composables/*" ],
      "@locale/*": [ "./src/locale/*" ],
      "@pages/*": [ "./src/pages/*" ],
      "@styles/*": [ "./src/styles/*" ],
      "@utils/*": [ "./src/utils/*" ],
      "@assets/*": [ "./src/assets/*" ],
      "@icons/*": [ "./src/assets/icons/*" ]
    }
  }
}
